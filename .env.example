# ============================================
# AI 醫療護理系統 - 環境配置範本
# ============================================
# --- 資料庫連線設定 (來自 Railway) ---
DB_HOST=tramway.proxy.rlwy.net
DB_PORT=18467
DB_NAME=railway
DB_USER=postgres
DB_PASSWORD=voWDUeaUmYjCDtcYJhzhpKQQiASMXnsD

# 資料庫類型選擇
# 可選值: oracle, postgresql, sqlite
DB_TYPE=postgresql

# ============================================
# PostgreSQL 配置
# ============================================
POSTGRESQL_HOST=localhost
POSTGRESQL_PORT=5432
POSTGRESQL_DB=nursing_db
POSTGRESQL_USER=postgres
POSTGRESQL_PASSWORD=postgres

# ============================================
# Oracle 配置
# ============================================
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SID=ORCL
ORACLE_USER=system
ORACLE_PASSWORD=oracle
ORACLE_DRIVER=cx_Oracle

# ============================================
# SQLite 配置
# ============================================
SQLITE_PATH=local_data/app.db

# ============================================
# 通用資料庫設定
# ============================================
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO_SQL=false

# ============================================
# AI 摘要服務設定
# ============================================
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o-mini

# ============================================
# 應用設定
# ============================================
APP_DEBUG=true
APP_LOG_LEVEL=INFO
# --- OpenAI API 設定 ---
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini # 推薦使用最新的高效模型

# ============================================================
# YOLOv8 + PaddleOCR 配置（新功能 - 圖像文字識別）
# ============================================================

# YOLOv8 OCR 全局開關
# true: 啟用 YOLOv8 + PaddleOCR 高精度識別
# false: 禁用 YOLOv8，使用 EasyOCR 作為後備方案（默認）
ENABLE_YOLOV8_OCR=false

# YOLOv8 模型置信度閾值 (0-1)
# 越高越嚴格，只保留高信度的識別結果
# 推薦值: 0.3-0.7（默認 0.5）
YOLOV8_CONFIDENCE=0.5

# YOLOv8 運行設備
# 'cpu': CPU 模式（兼容性好但較慢，~3-5 秒/張圖像）
# 'cuda': GPU 加速（需要 NVIDIA GPU 和 CUDA 環境，~0.5-1 秒/張）
# 'mps': Apple Metal Performance Shaders（Mac 用戶使用）
YOLOV8_DEVICE=cpu

# YOLOv8 模型大小
# 'nano': 6.3MB，快速推理（推薦）
# 'small': 22.5MB，更高精度
YOLOV8_MODEL_SIZE=nano

# 自動下載模型
# true: 首次啟動時自動下載 YOLOv8n.pt 模型（~30-60 秒）
# false: 手動下載管理
YOLOV8_AUTO_DOWNLOAD=true

# YOLOv8 模型快取
# true: 將模型快取到內存，加快後續識別
# false: 每次都從磁盤重新加載
YOLOV8_CACHE_ENABLED=true
