{
  "hospital_id": "HOSP_A",
  "hospital_name": "台北A醫院",
  "version": "1.1",
  "tables": [
    {
      "table_name": "DB_ADM_ORDER_ER",
      "display_name": "急診檢驗檢查主檔",
      "patient_id_col": "CHAD1MRNO",
      "time_col": "CHRCPDTM",
      "columns": [
        {"col_name": "CHAD4CDATE", "label": "採檢日期時間", "default_checked": true},
        {"col_name": "CHAD4ORDNAME", "label": "醫囑名稱", "default_checked": true},
        {"col_name": "CHTEAMNAM", "label": "開單科別", "default_checked": false},
        {"col_name": "CHAD4SPECT", "label": "檢體類別", "default_checked": true},
        {"col_name": "CHAD4STAT", "label": "狀態", "default_checked": true},
        {"col_name": "CHAD4REP1", "label": "報告註記", "default_checked": true},
        {"col_name": "CHREPORTDATE", "label": "報告日期", "default_checked": true},
        {"col_name": "CHTEXT", "label": "報告內容", "default_checked": true},
        {
          "col_name": "SOURCETYPE", 
          "label": "來源類別", 
          "default_checked": false,
          "value_mapping": {"O": "門診", "I": "住院", "E": "急診"}
        }
      ]
    },
    {
      "table_name": "DB_ADM_LABORDER_ER",
      "display_name": "急診檢驗頭檔",
      "patient_id_col": "CHMRNO",
      "time_col": "CHAPPDTM",
      "columns": [
        {"col_name": "CHAPPDTM", "label": "申請時間", "default_checked": true},
        {"col_name": "CHORDNAM", "label": "醫囑名稱", "default_checked": true},
        {
          "col_name": "CHSTAT", 
          "label": "狀態碼", 
          "default_checked": true,
          "value_mapping": {"11": "未收件", "30": "檢驗中", "50": "初步報告", "60": "報告確認", "70": "報告修改", "DC": "DC(取消)"}
        },
        {"col_name": "CHSPECI", "label": "檢體", "default_checked": true},
        {"col_name": "LABCLASS", "label": "檢驗類別", "default_checked": true}
      ]
    },
    {
      "table_name": "DB_ADM_LABDATA_ER",
      "display_name": "急診檢驗明細",
      "patient_id_col": "CHMRNO", 
      "time_col": "CHSIGNDTTM",
      "columns": [
        {"col_name": "CHHEAD", "label": "項目", "default_checked": true},
        {"col_name": "CHVAL", "label": "結果值", "default_checked": true},
        {"col_name": "CHUNIT", "label": "單位", "default_checked": true},
        {"col_name": "CHCOMMT", "label": "註記", "default_checked": true},
        {"col_name": "CHNL", "label": "參考值下限", "default_checked": true},
        {"col_name": "CHNH", "label": "參考值上限", "default_checked": true},
        {"col_name": "CHSIGNDTTM", "label": "簽核時間", "default_checked": true}
      ]
    },
    {
      "table_name": "ENSDATA",
      "display_name": "急診護理紀錄",
      "patient_id_col": "PATID",
      "time_col": "PROCDTTM",
      "columns": [
        {"col_name": "VISITDT", "label": "急診日期", "default_checked": true},
        {"col_name": "SUBJECT", "label": "主訴", "default_checked": true},
        {"col_name": "DIAGNOSIS", "label": "診斷", "default_checked": true},
        {"col_name": "CLOSE", "label": "結案", "default_checked": false},
        {"col_name": "FIINISH", "label": "完成", "default_checked": false}
      ]
    },
    {
      "table_name": "v_ai_hisensnes",
      "display_name": "生理監測",
      "patient_id_col": "PATID",
      "time_col": "PROCDTTM",
      "columns": [
        {"col_name": "EWEIGHT", "label": "體重", "default_checked": false},
        {"col_name": "ETEMPUTER", "label": "體溫", "default_checked": true},
        {
          "col_name": "ETREGION", 
          "label": "測量部位", 
          "default_checked": true,
          "value_mapping": {"1": "腋溫", "2": "耳溫", "3": "口溫", "4": "肛溫", "5": "額溫"}
        },
        {"col_name": "EPLUSE", "label": "脈搏", "default_checked": true},
        {"col_name": "EBREATHE", "label": "呼吸", "default_checked": true},
        {"col_name": "EPRESSURE", "label": "收縮壓", "default_checked": true},
        {"col_name": "EDIASTOLIC", "label": "舒張壓", "default_checked": true},
        {"col_name": "ESAO2", "label": "血氧(SaO2)", "default_checked": true},
        {"col_name": "GCS_E", "label": "昏迷指數_眼", "default_checked": true},
        {"col_name": "GCS_V", "label": "昏迷指數_聲", "default_checked": true},
        {"col_name": "GCS_M", "label": "昏迷指數_動", "default_checked": true},
        {
          "col_name": "ENESKIND", 
          "label": "檢傷級數", 
          "default_checked": true,
          "value_mapping": {"B": "留觀評估", "N": "檢傷評估"}
        }
      ]
    }
  ]
}