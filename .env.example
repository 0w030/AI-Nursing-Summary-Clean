# 資料庫類型選擇
# 可選值: oracle, postgresql, sqlite
DB_TYPE=postgresql

# ============================================
# PostgreSQL 配置
# ============================================
POSTGRESQL_HOST=localhost
POSTGRESQL_PORT=5432
POSTGRESQL_DB=nursing_db
POSTGRESQL_USER=postgres
POSTGRESQL_PASSWORD=postgres

# ============================================
# Oracle 配置
# ============================================
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SID=ORCL
ORACLE_USER=system
ORACLE_PASSWORD=oracle
ORACLE_DRIVER=cx_Oracle

# ============================================
# SQLite 配置
# ============================================
SQLITE_PATH=local_data/app.db

# ============================================
# 通用資料庫設定
# ============================================
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO_SQL=false

# ============================================
# AI 摘要服務設定
# ============================================
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o-mini

# ============================================
# 應用設定
# ============================================
APP_DEBUG=true
APP_LOG_LEVEL=INFO